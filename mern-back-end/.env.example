RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=Subazen <orders@subazen.com>
STOREFRONT_URL=https://subazen.com
DATABASE_BACKUP_ENCRYPTION_KEY=base64-encoded-32-byte-key-required
